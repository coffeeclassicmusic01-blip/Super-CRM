{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "emitDeclarationOnly": true
  },
  "include": ["vite.config.ts", "eslint.config.js", "vitest.config.ts"]
}
